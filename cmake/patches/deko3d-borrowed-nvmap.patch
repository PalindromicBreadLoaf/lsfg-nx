@@ -106,6 +106,45 @@ DkResult MemBlock::initialize(uint32_t flags, void* storage, uint32_t size)
 	return DkResult_Success;
 }
 
+DkResult MemBlock::initializeBorrowed(uint32_t flags, uint32_t nvMapId, uint32_t expectedSize) noexcept
+{
+	uint32_t cpuAccess = (flags >> DkMemBlockFlags_CpuAccessShift) & DkMemAccess_Mask;
+	uint32_t gpuAccess = (flags >> DkMemBlockFlags_GpuAccessShift) & DkMemAccess_Mask;
+	flags &= ~(DkMemBlockFlags_CpuAccessMask | DkMemBlockFlags_GpuAccessMask);
+
+	if (cpuAccess != DkMemAccess_None || gpuAccess == DkMemAccess_None ||
+		(flags & (DkMemBlockFlags_Code | DkMemBlockFlags_ZeroFillInit)))
+		return DkResult_BadInput;
+
+	flags |= gpuAccess << DkMemBlockFlags_GpuAccessShift;
+	m_flags = flags;
+	m_borrowed = true;
+
+	if (R_FAILED(nvMapLoadRemote(&m_mapObj, nvMapId)))
+		return DkResult_Fail;
+	getDevice()->incrNvMapCount();
+
+	if (expectedSize && getSize() != expectedSize)
+		return DkResult_BadInput;
+
+	if (R_FAILED(nvAddressSpaceMap(getDevice()->getAddrSpace(),
+		getHandle(), isGpuCached(), NvKind_Pitch, &m_gpuAddrPitch)))
+		return DkResult_Fail;
+
+	if (flags & DkMemBlockFlags_Image)
+	{
+		if (R_FAILED(nvAddressSpaceMap(getDevice()->getAddrSpace(),
+			getHandle(), isGpuCached(), NvKind_Generic_16BX2, &m_gpuAddrGeneric)))
+			return DkResult_Fail;
+
+		if (R_FAILED(nvAddressSpaceMap(getDevice()->getAddrSpace(),
+			getHandle(), isGpuCached(), NvKind_C32_2CRA, &m_gpuAddrCompressed)))
+			return DkResult_Fail;
+	}
+
+	return DkResult_Success;
+}
+
 void MemBlock::destroy()
 {
 	if (m_gpuAddrCompressed != DK_GPU_ADDR_INVALID)
@@ -170,6 +209,22 @@ DkMemBlock dkMemBlockCreate(DkMemBlockMaker const* maker)
 	return obj;
 }
 
+DkMemBlock dkMemBlockCreateBorrowed(DkBorrowedMemBlockMaker const* maker)
+{
+	DK_ENTRYPOINT(maker->device);
+	DK_DEBUG_NON_ZERO(maker->nvMapId);
+
+	DkMemBlock obj = new(maker->device) MemBlock(maker->device);
+	DkResult res = obj->initializeBorrowed(maker->flags, maker->nvMapId, maker->expectedSize);
+	if (res != DkResult_Success)
+	{
+		delete obj;
+		DK_ERROR(res, "borrowed NvMap initialization failure");
+		return nullptr;
+	}
+	return obj;
+}
+
 void dkMemBlockDestroy(DkMemBlock obj)
 {
 	DK_ENTRYPOINT(obj);
@@ -191,6 +246,11 @@ uint32_t dkMemBlockGetSize(DkMemBlock obj)
 	return obj->getSize();
 }
 
+bool dkMemBlockIsBorrowed(DkMemBlock obj)
+{
+	return obj->isBorrowed();
+}
